  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@fontsource/orbitron": "^5.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
